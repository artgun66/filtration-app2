# Sentence embeddings: 476 MB of cached .npy, over GitHub's 100 MB file limit.
# Regenerate with `python scam-classification/embed.py` (keyed by row id, so the
# rebuild is deterministic).
scam-classification/embeddings/

# Exported encoder graphs: 86 MB fp32 + 23 MB int8, both rebuilt by
# `python app-backend/export_onnx.py`. The small artifacts next to them -- the heads,
# the manifest, vocab.txt and golden_vectors.json -- ARE tracked: golden_vectors.json
# is the fixture app/test/golden.ts runs against, so it belongs in the repo.
app/assets/models/encoder_*.onnx

# React Native. android/ and ios/ are generated by `npx expo prebuild` and are not
# edited by hand, so they are regenerated rather than tracked.
node_modules/
app/android/
app/ios/
app/.expo/
app/dist/
*.apk

# The web build. public/models is staged from app/assets/models by
# `npm run prepare-assets` -- copies, never sources.
web/dist/
web/public/models/

# Readable per-split slices of the corpus, for looking at by eye. Views, not data --
# `python dataset/split_views.py` rebuilds them in seconds.
dataset/views/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Machine-local Claude Code permissions
.claude/settings.local.json
